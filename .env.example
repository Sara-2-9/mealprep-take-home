# OpenAI API key used by the meal-plan LLM workflow (screen 05).
# Get the take-home key from the brief or use your own.
EXPO_PUBLIC_OPENAI_API_KEY=sk-your-key-here

# Optional: model used for meal-plan generation (default: gpt-4o-mini).
# Any OpenAI model id works; swapping providers is a one-line change in
# lib/llm/client.ts thanks to the Vercel AI SDK.
# EXPO_PUBLIC_MEALPLAN_MODEL=gpt-4o-mini
